{
  "name": "local-ui-composer",
  "description": "Browser-local generative UI: Gemma 4 E2B on WebGPU (LiteRT-LM.js) or Chrome's built-in model composing A2UI v0.9 surfaces through a guardrailed design-system catalog.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.6",
    "@litert-lm/core": "0.14.0",
    "jsonrepair": "^3.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
